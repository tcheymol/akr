{% extends 'base.html.twig' %}

{% block title %}{{ 'spots'|trans }}{% endblock %}

{% set spotItems = [
    {'label': 'position', 'value': spot.position},
    {'label': 'access', 'value': spot.access},
    {'label': 'description', 'value': spot.description},
    {'label': 'orientation', 'value': spot.orientation},
    {'label': 'water', 'value': spot.water},
    {'label': 'dangers', 'value': spot.dangers},
    {'label': 'more', 'value': spot.more},
    {'label': 'security', 'value': spot.security},
] %}

{% block body %}
    <section
            class="page-section  w-100 masthead text-white position-relative"
            style="background: linear-gradient(to bottom, rgba(92, 77, 66, 0.8) 0%, rgba(92, 77, 66, 0.8) 100%), url({{ asset('img/bg.gif') }});"
    >
        <div class="min-vh-100 container p-4 px-lg-5">
            <h2 class="text-center font-weight-bold">{{ spot.name }}</h2>
            {% if spot.subtitle %}
                <hr class="divider"/>
                {{ spot.subtitle|raw }}
            {% endif %}
            <hr class="divider"/>
            {{ include('spots/_wg_widget.html.twig', {'wg_id': spot.windguruId, 'id': spot.id}) }}
            <hr class="divider"/>
            <div class="row">
                {% for spotItem in spotItems %}
                    {{ include('spots/_spot_item.html.twig', {'item': spotItem}) }}
                {% endfor %}
            </div>
            {% if spot.customContent %}
                <hr class="divider"/>
                <div class="row">
                    {{ spot.customContent|raw }}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
