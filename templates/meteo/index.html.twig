{% extends 'base.html.twig' %}

{% block title %}{{ 'meteo'|trans }}{% endblock %}

{% block mainSection %}
    <div class="row">
        <div class="col-12 col-md-6 d-flex justify-content-center align-items-center">
            <img class="img-fluid img-thumbnail" alt="trade_winds" src="{{ asset('build/img/trade_winds.gif') }}"/>
        </div>
        <div class="col-12 col-md-6">
            <h2 class="text-center font-weight-bold">{{ 'meteo'|trans }}</h2>
            {{ include('components/_text.html.twig', {text: intro1}) }}
            <hr class="divider"/>
            {{ include('components/_text.html.twig', {text: intro2}) }}
        </div>
    </div>
{% endblock %}


{% block body %}
    <div class="container p-4 p-lg-5">
        <div class="row">
            <div class="col-12 col-lg-8 offset-lg-2">
                {{ include('components/_text.html.twig', {text: body}) }}
            </div>
            <div class="col-12 col-lg-8 offset-lg-2 mt-4 d-flex justify-content-center">
                <a class="btn btn-primary btn-lg" href="{{ path('spots') }}">{{ 'see_all_spots' |trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}

{% block mainSectionBottom %}{% endblock %}
