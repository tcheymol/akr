{% extends 'base.html.twig' %}

{% block title %}{{ 'meteo'|trans }}{% endblock %}

{% block body %}
    <section
            class="page-section  w-100 masthead text-white position-relative"
            style="background: linear-gradient(to bottom, rgba(92, 77, 66, 0.8) 0%, rgba(92, 77, 66, 0.8) 100%), url({{ asset('img/bg.gif') }});"
    >
        <div class="min-vh-100 container p-4 px-lg-5">
            <div class="row">
                <div class="col-12 col-md-6 d-flex justify-content-center align-items-center">
                    <img class="img-fluid img-thumbnail" alt="trade_winds"
                         src="{{ asset('img/trade_winds.gif') }}"/>
                </div>
                <div class="col-12 col-md-6">
                    <h2 class="text-center font-weight-bold">{{ 'meteo'|trans }}</h2>
                    {{ include('components/_text.html.twig', {text: intro1}) }}
                    <hr class="divider"/>
                    {{ include('components/_text.html.twig', {text: intro2}) }}
                </div>
            </div>
            {{ include('components/_section_button.html.twig', {href: 'meteoIndex', isLast: false, color: 'primary'}) }}
        </div>
        <div id="meteoIndex" class="position-absolute"></div>
    </section>
    {{ include('components/_page_section.html.twig', {section, isLast: false, index: 2} ) }}
    {{ include('components/_page_section.html.twig', {section: section2, isLast: true, index: 3} ) }}
{% endblock %}
