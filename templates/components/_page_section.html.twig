{% set bgColor = index is odd ? '' : 'primary' %}
{% set accentColor = index is odd ? 'primary' : 'light' %}
{% set textColor = index is odd and index >= 2 ? 'primary' : 'white' %}

{% if section %}
    <section
            class="page-section position-relative bg-{{ bgColor }} w-100 {{ index == 1 ? 'masthead' : '' }} text-{{ textColor }}"
    >
        {% if index == 1 %}
            <video autoplay muted loop id="myVideo"
                   style="
                   position:absolute; height: 100%;  width: 100%; top: 0; left: 0;     object-fit: fill;"
            >
                <source
                        src="{{ asset('build/img/bg.mp4') }}" type="video/mp4"
                >
            </video>
        {% endif %}
        <div class="min-vh-100 container p-4 px-lg-5 position-relative" style="z-index: 1">
            <div class="row">
                <div class="col-lg-8 offset-lg-2 justify-content-center">
                    {{ include('components/_section_content.html.twig', {section, accentColor}) }}
                    {{ include('components/_section_button.html.twig', {href: section.name, isLast, color: accentColor}) }}
                </div>
            </div>
        </div>
        <div id="{{ section.name }}" class="position-absolute" style="bottom: 0;width: 1px; height: 1px"></div>
    </section>
{% endif %}
