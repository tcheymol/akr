{% extends 'base.html.twig' %}

{% block title %}{{ 'general_rules'|trans }}{% endblock %}

{% block body %}
    <section
            class="page-section w-100 masthead text-white position-relative"
            style="background: linear-gradient(to bottom, rgba(92, 77, 66, 0.8) 0%, rgba(92, 77, 66, 0.8) 100%), url({{ asset('build/img/bg.gif') }});"
    >
        <div class="min-vh-100 container p-4 px-lg-5">
            <div class="row">
                <div class="col-lg-8 offset-lg-2 justify-content-center">
                    <h2 class="text-center font-weight-bold">{{ 'important_information'|trans }}</h2>
                    <hr class="divider"/>
                    {{ include('components/_text.html.twig', {text: importantNotices}) }}
                    <hr class="divider"/>
                    <h2 class="text-center font-weight-bold">{{ 'general_rule_frame'|trans }}</h2>
                    <hr class="divider"/>
                    {{ include('components/_text.html.twig', {text: generalFrameContent}) }}
                    {{ include('components/_section_button.html.twig', {color: 'primary', isLast: true}) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
