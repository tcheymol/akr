{% extends 'base.html.twig' %}

{% block title %}{{ page.name }}{% endblock %}

{% block mainSection %}
    <div class="col-lg-12">
        {{ include('components/_section.html.twig', {section: page.sections.first}) }}
    </div>
{% endblock %}

{% block body %}
    {% for section in page.sections|slice(1, page.sections.count) %}
        {{ include('components/_page_section.html.twig', {
            section,
            color: loop.index is odd,
            isLast: loop.last
        }) }}
    {% endfor %}
{% endblock %}

{% block mainSectionBottom %}
{#    {% if page.sections.count >= 1 %}#}
        {% set section = page.sections|slice(1, 1)[0] %}
        {{ include('components/next_section_button.html.twig', {href: section.name}) }}
{#    {% endif %}#}
{% endblock %}