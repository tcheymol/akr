{% extends 'base.html.twig' %}

{% block title %}{{ 'spots'|trans }}{% endblock %}

{% block body %}
    <section
            class="page-section  w-100 masthead text-white position-relative"
            style="background: linear-gradient(to bottom, rgba(92, 77, 66, 0.8) 0%, rgba(92, 77, 66, 0.8) 100%), url({{ asset('build/img/bg.gif') }});"
    >
        <div class="min-vh-100 container p-4 px-lg-5">
            <div class="row">
                <div class="col-lg-8 offset-lg-2 justify-content-center">
                    <h2 class="text-center font-weight-bold">{{ 'spots'|trans }}</h2>
                    <hr class="divider"/>
                    {{ include('components/_text.html.twig', {text: spotsIntro}) }}
                </div>
                {{ include('components/_section_button.html.twig', {href: 'spotsIndex', isLast: false, color: 'primary'}) }}
            </div>
        </div>
        <div id="spotsIndex" class="position-absolute"></div>
    </section>

    {{ include('components/_page_section.html.twig', {section: spotsRecommendationsSection, isLast: false, index: 2} ) }}

    <div class="container p-4 p-lg-5">
        <div class="row">
            {% for spot in spots %}
                {{ include('spots/_spot.html.twig', { spot }) }}
            {% endfor %}
        </div>
    </div>
{% endblock %}
