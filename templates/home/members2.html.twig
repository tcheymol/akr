{{ include('components/_page_section.html.twig', {
    section,
    color: loop.index is odd,
    isLast: loop.last
}) }}

{% block content %}
    <div class="col-12">
        <div class="row d-flex align-items-center" style="min-height: calc(100vh - 122px)">
            <h2 class="text-white mt-0">{{ 'where_to_find_members'|trans }}</h2>
            <h6 class="text-white mt-0">
                {{ 'where_to_find_members_title_1'|trans }}: {{ 'where_to_find_members_title_2'|trans }}</h6>
            <hr class="hr-light"/>
            <div class="row">
                <div class="col col-12 col-md-6 d-flex flex-column align-content-center justify-content-between">
                    <p class="text-white mb-4">{{ 'where_to_find_members_spot_1' |trans|raw }}</p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="text-white mb-4">{{ 'where_to_find_members_spot_2' |trans|raw }}</p>
                </div>
            </div>
            <div class="col-12">
                <a class="btn btn-light btn-lg rounded-pill" href="{{ path('spots') }}">{{ 'see_all_spots' |trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
