<h1 class="text-center font-weight-bold">{{ section.name }}</h1>
{% for text in section.texts %}
    <h2 class="text-center font-weight-bold">{{ text.title }}</h2>
    <hr class="divider" {% if textColor is defined %}style="background-color: {{ textColor }}"{% endif %}/>
    {{ include('components/_text.html.twig', {text}) }}
{% endfor %}
<div id="{{ section.name }}"></div>
