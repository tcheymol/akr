{% set color = color is defined ? color : 'primary' %}
{% set textColor = color is same as 'primary' ? 'light' : 'primary' %}
{% set subtitle = subtitle is defined ? subtitle : null %}

<section class="page-section bg-{{ color }}" id="about" data-turbolinks="false">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-lg-8 text-center">
                {{ include('components/_section_content.html.twig', {textColor, title, subtitle, content}) }}
            </div>
        </div>
        {{ include('components/_section_button.html.twig', {color: textColor, href: title})}}
    </div>
</section>
<div id="{{ title }}"></div>

