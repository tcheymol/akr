{% extends 'base.html.twig' %}

{% block title %}{{ 'login'|trans }}{% endblock %}

{% block body %}
    <section
            class="page-section w-100 position-relative masthead text-white"
            style="background: linear-gradient(to bottom, rgba(92, 77, 66, 0.8) 0%, rgba(92, 77, 66, 0.8) 100%), url({{ asset('build/img/bg.gif') }});"
    >
        <div class="min-vh-100 container p-4 px-lg-5">
            <div class="row">
                {% if error %}
                    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                    <form action="{{ path('login') }}" method="post">
                        <div class="form-group my-4">
                            <label for="username">{{ 'email'|trans }}</label>
                            <input type="text" id="username" name="_username" class="form-control"
                                   value="{{ last_username }}"/>
                        </div>

                        <div class="form-group my-4">
                            <label for="password">{{ 'password'|trans }}</label>
                            <input type="password" id="password" name="_password" class="form-control"/>
                        </div>

                        <button type="submit" class="col-12 btn btn-primary btn-lg">{{ 'login'|trans }}</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
